{
  "name": "agentic-ops",
  "dockerComposeFile": "../compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/agentic-ops",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "pip install -c requirements.txt -e '.[dev]'",
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}